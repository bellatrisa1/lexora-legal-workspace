{
  "name": "client-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:dev": "tsx watch --env-file=.env server/index.ts",
    "api:start": "tsx --env-file=.env server/index.ts",
    "db:migrate": "tsx --env-file=.env server/db-cli.ts migrate",
    "db:seed": "tsx --env-file=.env server/db-cli.ts seed",
    "test:integration": "vitest run tests/server.test.ts",
    "test:e2e:rest": "playwright test --config playwright.rest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "express": "^5.3.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
